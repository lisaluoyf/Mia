TELEGRAM_BOT_TOKEN=
APIMASTER_BASE_URL=https://apimaster.ai
# Optional: use an internal address when Mia runs beside APIMaster.
# APIMASTER_INTERNAL_BASE_URL=http://127.0.0.1:3000
# Required: APIMaster Web identity service for login, bindings, and sessions.
APIMASTER_IDENTITY_BASE_URL=http://127.0.0.1:3000
MIA_INTERNAL_SERVICE_KEY=
HOST=127.0.0.1
PORT=3010
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=60000
DATABASE_PATH=data/mia.sqlite
MINI_APP_AUTH_MAX_AGE_SECONDS=86400
# Natural-language intent and direct chat/vision answers use this model with
# the triggering user's APIMaster Key. Mia does not own a routing Key.
MIA_ROUTER_MODEL=gpt-5.4
MIA_ROUTER_TIMEOUT_MS=90000
# Every 10 successful private-chat rounds, this model refreshes long-term memory and the rolling summary.
MIA_CONTEXT_MODEL=gpt-5.4
# Dedicated APIMaster Token restricted to the guest text-chat model only.
MIA_GUEST_CHAT_API_KEY=
MIA_GUEST_CHAT_MODEL=gpt-5.4
# Public HTTPS origin used for one-click downloads and image share pages.
# MIA_PUBLIC_BASE_URL=https://apimaster.ai
MIA_DEBUG_ALLOWED_EMAILS=lisa.luoyf@gmail.com
MIA_ACTIVATION_ENABLED=false
MIA_ACTIVATION_INTERVAL_MS=60000
MIA_ACTIVATION_DAILY_LIMIT=50
# Comma-separated Telegram user IDs. This sends all activation previews only to those chats on startup.
MIA_ACTIVATION_PREVIEW_TELEGRAM_USER_IDS=
MEDIA_WORKER_INTERVAL_MS=5000
MEDIA_RESULT_MAX_BYTES=50000000
# Agent rollout is opt-in and additionally requires explicit Telegram user IDs.
MIA_AGENT_ENABLED=false
MIA_AGENT_ALLOWED_USERS=
# Enable only after verifying hosted search support on the selected chat model.
MIA_AGENT_WEB_SEARCH=false
# Agent model requests include hosted Web Search when enabled. New input/cancel still interrupts;
# this is only the connection and resource ceiling, not a per-search budget.
MIA_AGENT_TIMEOUT_MS=300000
# Internal Agent Loop verification. The probe uses only text and hosted Web Search,
# records delivery locally, and never sends Telegram messages or creates media jobs.
MIA_AGENT_SMOKE_ENABLED=false
# Defaults to the first MIA_AGENT_ALLOWED_USERS entry when empty.
MIA_AGENT_SMOKE_USER_ID=
MIA_AGENT_SMOKE_MODEL=gpt-5.6-luna
# Six hours; alert only after the configured consecutive failure count.
MIA_AGENT_SMOKE_INTERVAL_MS=21600000
MIA_AGENT_SMOKE_FAILURE_THRESHOLD=3
